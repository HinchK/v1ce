{
  "expo": {
    "name": "V1CE",
    "slug": "v1ce-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "v1ce",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.v1ce",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.v1ce"
        ]
      }
    },
    "android": {
      "package": "app.v1ce"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "@bacons/apple-targets"
      ],
      "./plugins/withV1CEWidgetFonts.js",
      "./plugins/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
